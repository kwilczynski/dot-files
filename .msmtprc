defaults
auth on
port 465
tls on
tls_certcheck on
tls_starttls off
tls_priorities SECURE256:+SECURE128:-VERS-ALL:+VERS-TLS1.3
logfile ~/.msmtp/msmtp.log

account gmail
host smtp.gmail.com
from kw@linux.com
user
password

account kernel
host mail.kernel.org
from kwilczynski@kernel.org
user
password

account default : gmail
