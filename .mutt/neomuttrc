reset all
unhook *

set realname = "Krzysztof Wilczyński"
set from     = "kw@linux.com"

set hostname    = "rocinante"
set hidden_host = yes

alternates \
  "((kw|kwilczynski|krzysztof.wilczynski)@(linux.com|kernel.org|fsck.io))"

set quit = ask-yes

unset user_agent
unset use_domain

set use_from          = yes
set use_envelope_from = yes

set edit_headers  = yes
set fast_reply    = yes
set reply_to      = yes
set include       = yes
set askcc         = yes

set fcc_attach = yes
set fcc_clear  = no

set reverse_name     = yes
set reverse_realname = yes

set postpone         = ask-yes
set abort_unmodified = ask-yes
set abort_nosubject  = no

set forward_format = "Fwd: %s"
set forward_decode = yes
set forward_quote  = yes

set mime_forward = no

set attribution = "On %d, %n wrote:"

set message_id_format = "<%Y%02m%02d%02H%02M%02S.G%c%p@%f>"

set mail_check = 30
set timeout    = 300

set sendmail      = "msmtp"
set sendmail_wait = 0

set header_cache_compress_method = "zlib"
set header_cache_backend         = "lmdb"

set folder    = "~/Mail/gmail"
set spoolfile = "+INBOX"
unset record
set postponed = "+[Gmail]/Drafts"
set trash     = "+[Gmail]/Bin"

set move = no

set mark_old        = no
set collapse_unread = yes

set header_cache = "~/.mutt/cache/headers"

set sleep_time = 0

set auto_tag = yes

set sort         = "threads"
set sort_aux     = "reverse-last-date-received"
set sort_browser = "reverse-date"

set strict_threads    = yes
set duplicate_threads = yes

set uncollapse_jump = yes

auto_view "text/html"

alternative_order \
  "text/plain"    \
  "text/enriched" \
  "text/html"     \
  "*"


bind index \e[M noop
bind pager \e[M noop

bind index g noop
bind pager g noop

bind index gg first-entry
bind index G last-entry
bind index <tab> sync-mailbox
bind index <space> collapse-thread

unset markers

set smart_wrap        = yes
set pager_stop        = yes
set pager_index_lines = 10
set pager_context     = 3
bind pager gg top
bind pager G bottom
bind pager R group-reply
bind pager k previous-line
bind pager j next-line

set editor = "vim -c 'set syntax=mail filetype=mail'"
bind editor ^T complete
bind editor <tab> complete-query
bind editor <space> noop

set rfc2047_parameters = yes

set charset         = "utf-8"
set assumed_charset = "utf-8"
set send_charset    = "us-ascii:utf-8"

set date_format  = "%y-%m-%d %T"
set index_format = "%2C | %Z [%d] %-30.30F (%-4.4c) %s"

set wait_key = no
set tilde    = yes

set menu_scroll = yes

ignore "*"
unignore \
  "From" \
  "To"   \
  "Cc"   \
  "Bcc"  \
  "Date" \
  "Subject"

unhdr_order "*"
hdr_order \
  "From:" \
  "To:"   \
  "Cc:"   \
  "Bcc:"  \
  "Date:" \
  "Subject:"

bind index,pager B sidebar-toggle-visible

set sidebar_visible       = no
set sidebar_width         = 35
set sidebar_format        = "%B%?F? [%F]?%* %?N?%N/?%S"
set sidebar_short_path    = yes
set sidebar_delim_chars   = "/."
set sidebar_folder_indent = yes
set sidebar_indent_string = "  "

bind index,pager \Cp sidebar-prev
bind index,pager \Cn sidebar-next
bind index,pager \Co sidebar-open

mailboxes \
  "=INBOX" \
  "=[Gmail]/Sent Mail" \
  "=[Gmail]/Drafts" \
  "=[Gmail]/Starred" \
  "=[Gmail]/Spam" \
  "=[Gmail]/Bin" \
  "=Linux PCI"

macro index "^" "<shell-escape>mbsync -a<enter>" "Sync Mail"

macro compose <f1> "<edit-from>^UKrzysztof Wilczyński <kw@linux.com><enter>"
macro compose <f2> "<edit-from>^UKrzysztof Wilczyński <kwilczynski@kernel.org><enter>"

macro index,pager ! "<save-message>=[Gmail]/Spam<enter><enter>"      "Report as Spam"
macro index,pager + "<save-message>=[Gmail]/Important<enter><enter>" "Mark as Important"
macro index,pager e "<save-message>=[Gmail]/All Mail<enter><enter>"  "Archive Message"
macro index,pager d "<save-message>=[Gmail]/Bin<enter><enter>"       "Delete Message"

macro index,pager gi "<change-folder>=INBOX<enter>"             "Go to Inbox"

macro index,pager gs "<change-folder>=[Gmail]/Sent Mail<enter>" "Go to Sent"
macro index,pager gd "<change-folder>=[Gmail]/Drafts<enter>"    "Go to Drafts"
macro index,pager gS "<change-folder>=[Gmail]/Starred<enter>"   "Go to Starred"
macro index,pager gp "<change-folder>=Linux PCI<enter>"         "Go to Linux PCI"

set record = "+[Gmail]/Sent Mail"
set copy = yes
send2-hook "~f kwilczynski@kernel.org" "set sendmail = 'msmtp -a kernel'; set copy = yes"
send2-hook "!~f kwilczynski@kernel.org" "set sendmail = 'msmtp'; set copy = no"

source ~/.mutt/dracula.muttrc
